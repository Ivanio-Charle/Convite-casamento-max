# ==============================================================================
# CONVITE DIGITAL DE CASAMENTO — DANIEL & SOFIA (CHARLE CONVITES)
# Copie este ficheiro para .env e preencha os valores reais do seu ambiente.
# NUNCA coloque credenciais reais directamente no código ou no controlo de versões.
# ==============================================================================

# 1. Base de Dados PostgreSQL / Neon (Obrigatório para gravar confirmações RSVP)
# Exemplo Neon: postgresql://<utilizador>:<password>@<endpoint>.<regiao>.aws.neon.tech/<bd>?sslmode=require
DATABASE_URL=""

# 2. Token de segurança para consultar a lista de confirmações via GET /api/rsvp
# Gere uma chave aleatória segura (ex.: openssl rand -hex 32)
RSVP_ADMIN_TOKEN=""

# 3. URL institucional da marca Charle Convites (opcional; por omissão usa /marca)
NEXT_PUBLIC_CHARLE_CONVITES_URL=""

# 4. Caminho opcional para ficheiro de música de fundo (opcional; se vazio, procura automaticamente em public/audio/)
NEXT_PUBLIC_AUDIO_URL=""

# 5. Activar modo de imagens pré-optimizadas em Cloudflare Workers (opcional: "true" ou "false")
CLOUDFLARE_WORKERS="false"
